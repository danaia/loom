// First executable specimen of Pqo's canonical agent-native syntax.
// Integration is native Pqo; contact remains an explicit Metal escape hatch.

pqo 0.1
module hello_particle
target metal

const world.gravity: f32x3<m/s^2> = [0, -9.81, 0]
const ground.height: f32<m> = 0

stream particles.position: f32x3<m> {
  cap=1 len=1 buffers=1 access=rw storage=device
  init=[[0, 1, 0]]
}

stream particles.velocity: f32x3<m/s> {
  cap=1 len=1 buffers=1 access=rw storage=device
  init=[[0, 0, 0]]
}

stream particles.radius: f32<m> {
  cap=1 len=1 buffers=1 access=r storage=device
  init=[0.004]
}

stream particles.restitution: f32 {
  cap=1 len=1 buffers=1 access=r storage=device
  init=[0.8]
}

stream particles.friction: f32 {
  cap=1 len=1 buffers=1 access=r storage=device
  init=[0.3]
}

stream particles.color: f32x4 {
  cap=1 len=1 buffers=1 access=r storage=device
  init=[[1, 0.2, 0.4, 1]]
}

kernel integrate(
  position: rw stream<f32x3,m>,
  velocity: rw stream<f32x3,m/s>,
  gravity: in value<f32x3,m/s^2>,
  dt: in value<f32,s>
) each i {
  velocity[i] += gravity * dt;
  position[i] += velocity[i] * dt;
}

kernel contact_ground(
  position: rw stream<f32x3,m>,
  velocity: rw stream<f32x3,m/s>,
  radius: in stream<f32,m>,
  restitution: in stream<f32>,
  friction: in stream<f32>,
  ground_height: in value<f32,m>
) extern metal {
  source="kernels/ground_contact.metal"
  entry="ground_contact_main"
}

pass fall = integrate(
  position=particles.position
  velocity=particles.velocity
  gravity=world.gravity
  dt=simulation.fixed_dt
) over particles.position

pass bounce = contact_ground(
  position=particles.position
  velocity=particles.velocity
  radius=particles.radius
  restitution=particles.restitution
  friction=particles.friction
  ground_height=ground.height
) over particles.position

view viewport(
  color=particles.color
  position=particles.position
  radius=particles.radius
) extern metal {
  source="shaders/particle.metal"
  entry="particle_pipeline"
}

flow simulation rate=120hz {
  fall -> bounce
  draw viewport after bounce
}
